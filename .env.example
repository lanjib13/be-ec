NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL connection strings.
# Use the pooler URL for DATABASE_URL and the direct connection URL for DIRECT_URL.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Satu bucket publik per fitur: <prefix>-about, <prefix>-program, dst.
SUPABASE_STORAGE_BUCKET_PREFIX=ec
# Hanya dipakai oleh scripts/migrate-storage-buckets.js untuk memindahkan aset lama.
SUPABASE_STORAGE_LEGACY_BUCKET=ec-public

# Admin API login. Use a unique password and a random JWT secret (at least 32 characters).
ADMIN_USERNAME=adminec
ADMIN_PASSWORD=adminec12345
ADMIN_JWT_SECRET=replace-with-a-long-random-secret

# Set a long random value; never commit the real value.
VOTER_HASH_SALT=replace-with-a-long-random-secret

# Optional SMTP settings for event and recruitment confirmation emails.
# Obtain the server/port/security settings from your campus mail administrator.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=entrepreneurs.club@unu-jogja.ac.id
